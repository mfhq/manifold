[Unit]
Description=Manifold Download Helper Socket

[Socket]
ListenStream=@MF_FETCH_SOCKET_PATH@
FileDescriptorName=varlink
# only manifoldd talks to the helper
SocketMode=0600
# a helper of its own for every connection
Accept=yes
MaxConnections=16

[Install]
WantedBy=sockets.target
