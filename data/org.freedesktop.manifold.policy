<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- SPDX-License-Identifier: LGPL-2.1-or-later -->
<policyconfig>
  <vendor>Manifold</vendor>
  <vendor_url>https://github.com/ximion/manifold</vendor_url>

  <!-- Trusted components come from a configured remote, or from a bundle whose signature
       verifies against a key the host trusts -->
  <action id="org.freedesktop.manifold.install">
    <description>Install trusted components</description>
    <message>Authentication is required to install software from a configured repository</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <!-- An untrusted bundle is unsigned, or signed by a key the host does not trust -->
  <action id="org.freedesktop.manifold.install-untrusted">
    <description>Install untrusted components</description>
    <message>Authentication is required to install a software bundle from an untrusted source</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>

  <!-- System services and udev rules can give a component root access to the host -->
  <action id="org.freedesktop.manifold.install-privileged">
    <description>Install components with system services or udev rules</description>
    <message>Authentication is required to install software that can gain full access to this system</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>

  <!-- A remote is trusted to deliver software, so adding one is as dangerous as installing from it.
       Inspecting a repository changes nothing, but makes the service download from any https URL -->
  <action id="org.freedesktop.manifold.manage-remotes">
    <description>Manage software repositories</description>
    <message>Authentication is required to change the software repositories of the system</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <!-- The install mode decides whether a cleanup removes the component -->
  <action id="org.freedesktop.manifold.mark">
    <description>Mark software components to be kept or removed automatically</description>
    <message>Authentication is required to change whether a software component is kept</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
  </action>

  <!-- Refreshing only downloads metadata, which is verified before it is used -->
  <action id="org.freedesktop.manifold.refresh">
    <description>Refresh the metadata of software repositories</description>
    <message>Authentication is required to refresh the metadata of software repositories</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>yes</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

  <action id="org.freedesktop.manifold.remove">
    <description>Remove software components</description>
    <message>Authentication is required to remove a software component</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
</policyconfig>
